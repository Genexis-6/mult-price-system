# Dockerfile.worker - Worker image
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    curl \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from base image
COPY --from=mult-price-base:latest /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Don't set these - they'll come from .env

# Create logs directory
RUN mkdir -p /app/logs

# Copy application code
COPY . .

# Run as root for development
# USER appuser is REMOVED

# Run the worker
CMD ["taskiq", "worker", "worker.main:broker", "--workers", "4", "--log-level", "INFO"]